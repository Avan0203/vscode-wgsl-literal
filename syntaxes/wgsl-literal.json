{
  "fileTypes": ["js", "jsx", "ts", "tsx", "vue", "mjs", "html", "md"],
  "injectionSelector": "L:(source.js | source.ts | source.tsx | source.jsx | source.js.jsx | source.vue | text.html.vue | meta.embedded.block.javascript | meta.embedded.block.typescript | meta.embedded.block.typescriptreact) -comment -string",
  "patterns": [
    {
      "begin": "(?i)(\\s?\\/\\*\\s?(wgsl)\\s?\\*\\/\\s?)(`)",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        "2": {
          "name": "entity.name.function.tagged-template.js"
        },
        "3": {
          "name": "punctuation.definition.string.template.begin.js string.template.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.js string.template.js"
        }
      },
      "patterns": [
        {
          "include": "source.wgsl"
        }
      ]
    }
  ],
  "scopeName": "wgsl-literal-enhanced"
}
