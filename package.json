{
  "name": "wgsl-literal-enhanced",
  "displayName": "WGSL Literal Enhanced",
  "description": "An enhanced plugin based on the `vscode-wgsl-literal` plugin, adds WGSL syntax highlighting for js,vue,ts,tsx,html,md",
  "version": "0.0.1",
  "author": "Avan0203",
  "publisher": "Avan0203",
  "bugs":{
    "url": "https://github.com/Avan0203/vscode-wgsl-literal/issues"
  },
  "repository": {
    "url": "https://github.com/Avan0203/vscode-wgsl-literal.git"
  },
  "engines": {
    "vscode": "^1.15.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "shader",
    "wgsl-literal",
    "webgpu",
    "highlight",
    "markdown",
    "html",
    "vue",
    "js",
    "jsx",
    "ts",
    "tsx",
    "mjs",
    "wgsl",
    "template"
  ],
  "extensionDependencies": [
    "PolyMeilex.wgsl"
  ],
  "icon": "icon.png",
  "contributes": {
    "grammars": [
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.vue",
          "text.html.vue",
          "source.mjs",
          "text.html.derivative",
          "text.html.markdown"
        ],
        "scopeName": "wgsl-literal-enhanced",
        "path": "./syntaxes/wgsl-literal.json",
        "embeddedLanguages": {
          "source.wgsl": "wgsl"
        }
      },
      {
        "scopeName": "markdown.wgsl.codeblock",
        "path": "./syntaxes/wgsl-markdown-codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.wgsl": "wgsl"
        }
      }
    ]
  }
}
